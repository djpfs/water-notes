{
  "name": "water-notes",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create water-notes",
    "db:migrate:local": "wrangler d1 migrations apply water-notes --local",
    "db:migrate:remote": "wrangler d1 migrations apply water-notes --remote"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.3.11",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "wrangler": "^4.126.0"
  }
}
